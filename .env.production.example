# ==============================================================
# Photon — Production Infrastructure
# ==============================================================
# Copy to .env. Replace REPLACE_* values before deployment.
# Laravel settings belong in server/.env; frontend settings
# belong in client/.env. This file is used for Compose interpolation only.
# Required secrets are active below; optional overrides are commented.
# Internal service hosts and ports are fixed in docker-compose.prod.yml.
# ==============================================================

# ─── Deployment ────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=photon-prod
FORWARD_APP_PORT=8010

# ─── Database — shared by MySQL and Laravel ────────────────────
DB_DATABASE=photon
DB_USERNAME=photon
DB_PASSWORD=REPLACE_DB_PASSWORD
# Used only by MySQL; never passed to Laravel.
DB_ROOT_PASSWORD=REPLACE_DB_ROOT_PASSWORD

# ─── Redis — shared by Redis, Laravel and SSE ──────────────────
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD
REDIS_PREFIX=photon

# ─── SSE — browser access ──────────────────────────────────────
# Match APP_URL_CLIENT in server/.env (scheme + host + port).
# Multiple allowed origins are separated by commas.
SSE_ALLOWED_ORIGINS=https://app.example.com
