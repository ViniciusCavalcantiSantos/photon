# ==============================================================
# Photon — Production Laravel Application
# ==============================================================
# Copy to server/.env. Replace REPLACE_* values and domains.
# Loaded by Compose into app, queue and scheduler through env_file.
# Required configuration is active; optional overrides are commented.
# Shared DB/Redis credentials live only in the root .env.
# Compose fixes APP_ENV=production, APP_DEBUG=false and internal addresses.
# ==============================================================

# ─── Application — required identity and public URLs ───────────
APP_NAME="Photon Cloud"
# Generate once with php artisan key:generate --show; keep across deploys.
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
APP_URL=https://api.example.com
APP_URL_CLIENT=https://app.example.com
# Also set SSE_ALLOWED_ORIGINS in the root .env to this frontend.

# ─── Authentication — browser sessions ─────────────────────────
# Domains have no scheme or path. Sanctum entries may include a port.
SESSION_DOMAIN=.example.com
SANCTUM_STATEFUL_DOMAINS=app.example.com
SESSION_DRIVER=redis
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/

# ─── Queue and cache ───────────────────────────────────────────
# Connection credentials and REDIS_PREFIX are supplied by Compose.
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ─── File storage — required external S3-compatible bucket ─────
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=REPLACE_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_AWS_SECRET_KEY
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=REPLACE_BUCKET
# Optional public/CDN URL used to generate file links.
# AWS_URL=https://cdn.example.com
# Optional service API endpoint; omit for AWS S3's regional endpoint.
# AWS_ENDPOINT=https://s3.example.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Email — required SMTP delivery ────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=REPLACE_SMTP_HOST
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=REPLACE_SMTP_USER
MAIL_PASSWORD=REPLACE_SMTP_PASSWORD
MAIL_FROM_ADDRESS=notifications@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ─── Face recognition — AWS Rekognition ────────────────────────
REKOGNITION_COLLECTION_ID=REPLACE_COLLECTION_ID
REKOGNITION_USE_S3_OBJECT=false
# By default, uses the storage disk, bucket, AWS region and credentials.
# Uncomment only to override them; empty values suppress the defaults.
# For direct S3 access, enable USE_S3_OBJECT and use an AWS S3 bucket.
# REKOGNITION_DISK=s3
# REKOGNITION_BUCKET=another-bucket
# REKOGNITION_REGION=us-east-1
# REKOGNITION_KEY=REPLACE_REKOGNITION_KEY
# REKOGNITION_SECRET=REPLACE_REKOGNITION_SECRET

# ─── Optional integrations ─────────────────────────────────────
# Google OAuth — uncomment the complete provider group to enable.
# GOOGLE_CLIENT_ID=REPLACE_GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET=REPLACE_GOOGLE_CLIENT_SECRET
# GOOGLE_REDIRECT_URL="${APP_URL}/api/auth/google/callback"

# Microsoft OAuth
# MICROSOFT_CLIENT_ID=REPLACE_MICROSOFT_CLIENT_ID
# MICROSOFT_CLIENT_SECRET=REPLACE_MICROSOFT_CLIENT_SECRET
# MICROSOFT_REDIRECT_URL="${APP_URL}/api/auth/microsoft/callback"

# LinkedIn OAuth
# LINKEDIN_CLIENT_ID=REPLACE_LINKEDIN_CLIENT_ID
# LINKEDIN_CLIENT_SECRET=REPLACE_LINKEDIN_CLIENT_SECRET
# LINKEDIN_REDIRECT_URL="${APP_URL}/api/auth/linkedin/callback"

# Deployment webhook — requires the script and permissions in the container.
# GITHUB_WEBHOOK_SECRET=REPLACE_WEBHOOK_SECRET

# ─── Runtime defaults — logging ────────────────────────────────
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ─── Runtime defaults — localization ───────────────────────────
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ─── Runtime defaults — maintenance and application options ────
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
MAX_EMAIL_CONFIRMATION_ATTEMPTS=5
IMAGE_PROXY=false
