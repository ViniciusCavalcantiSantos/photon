# ==============================================================
# Photon — Development Laravel Application (Docker)
# ==============================================================
# Copy to server/.env. Compose supplies DB/Redis credentials from the
# root .env and fixes their internal hosts, ports and connection driver.
# For native PHP execution, supply those connection settings separately.
# ==============================================================

# ─── Application ───────────────────────────────────────────────
APP_NAME="Photon Cloud"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_URL_CLIENT=http://localhost:3000

# ─── Sessions, queue and cache ─────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:3000
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ─── Storage — local MinIO ─────────────────────────────────────
# MinIO values below reference the variables injected from the root .env.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID="${MINIO_ROOT_USER}"
AWS_SECRET_ACCESS_KEY="${MINIO_ROOT_PASSWORD}"
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET="${MINIO_BUCKET_PUBLIC}"
AWS_URL="${MINIO_PUBLIC_URL}"
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ─── Email — local Mailpit ─────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS="oficial@photon.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Face recognition — AWS Rekognition ────────────────────────
# Uncomment overrides only when needed; blanks suppress defaults.
REKOGNITION_COLLECTION_ID=photon-faces-dev
REKOGNITION_USE_S3_OBJECT=false
# REKOGNITION_DISK=s3
# REKOGNITION_BUCKET=another-bucket
# REKOGNITION_REGION=us-east-1
# REKOGNITION_KEY=REPLACE_REKOGNITION_KEY
# REKOGNITION_SECRET=REPLACE_REKOGNITION_SECRET

# ─── OAuth — optional providers ────────────────────────────────
GOOGLE_CLIENT_ID=null
GOOGLE_CLIENT_SECRET=null
GOOGLE_REDIRECT_URL="${APP_URL}/api/auth/google/callback"

MICROSOFT_CLIENT_ID=null
MICROSOFT_CLIENT_SECRET=null
MICROSOFT_REDIRECT_URL="${APP_URL}/api/auth/microsoft/callback"

LINKEDIN_CLIENT_ID=null
LINKEDIN_CLIENT_SECRET=null
LINKEDIN_REDIRECT_URL="${APP_URL}/api/auth/linkedin/callback"

# ─── Logging ───────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Localization ──────────────────────────────────────────────
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ─── Maintenance ───────────────────────────────────────────────
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=redis

# ─── Security ──────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── Application options ───────────────────────────────────────
MAX_EMAIL_CONFIRMATION_ATTEMPTS=5
IMAGE_PROXY=false
GITHUB_WEBHOOK_SECRET=
